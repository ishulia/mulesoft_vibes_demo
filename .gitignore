# ------------------------------------------------------------------------------ #
# Java defaults (https://github.com/github/gitignore/blob/master/Java.gitignore) #
# ------------------------------------------------------------------------------ #
*.class
*.jks

# Package Files #
*.jar
*.war
*.ear

# ------------------------------------------------------------------------------------------- #
# Eclipse-specific (https://github.com/github/gitignore/blob/master/Global/Eclipse.gitignore) #
# ------------------------------------------------------------------------------------------- #
*.pydevproject
.metadata
bin/**
tmp/**
tmp/**/*
*.tmp
*.bak
*.swp
*~.nib
local.properties
.settings/
.loadpath
.project
.classpath

# External tool builders
.externalToolBuilders/

# Locally stored "Eclipse launch configurations"
*.launch

# CDT-specific
.cproject

# PDT-specific
.buildpath

# --------------- #
# Studio-specific #
# --------------- #
target/
.mule/
.DS_Store
velocity.log

# ------------------------------------------------------------------------------ #
# ACB defaults #
# ------------------------------------------------------------------------------ #
.tooling-project

# ------------------------------------------------------------------------------ #
# Secure Properties — never commit real encrypted secrets for local env           #
# ------------------------------------------------------------------------------ #
users-api/src/main/resources/secure-local.yaml

# ACB DataWeave Playground — IDE-generated preview inputs, not project artifacts
src/test/resources/embedded-dw_*/
.vscode/launch.json
